{
  "name": "ai-fleet-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "install:browsers": "playwright install chromium",
    "start": "bun run src/index.ts",
    "once": "bun run src/index.ts --once",
    "dashboard": "bun run src/index.ts --dashboard",
    "audit:db": "bun run scripts/db-audit.mjs --legacy",
    "backup:db": "bun run scripts/db-backup.mjs --legacy",
    "restore:db": "bun run scripts/db-restore.mjs --legacy",
    "audit:observatory": "bun run scripts/db-audit.mjs --observatory",
    "backup:observatory": "bun run scripts/db-backup.mjs --observatory",
    "restore:observatory": "bun run scripts/db-restore.mjs --observatory",
    "probe:headless": "bun run scripts/headless-probe.ts",
    "telegram:test": "bun run scripts/telegram-test.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:performance": "node scripts/ui-performance.mjs"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.11",
    "@oh-my-pi/pi-natives": "18.0.11",
    "chart.js": "4.5.1",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
