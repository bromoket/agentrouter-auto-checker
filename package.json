{
  "name": "agentrouter-auto-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "start": "bun run src/index.ts",
    "once": "bun run src/index.ts --once",
    "dashboard": "bun run src/index.ts --dashboard",
    "audit:db": "bun run scripts/db-audit.mjs",
    "backup:db": "bun run scripts/db-backup.mjs",
    "probe:headless": "bun run scripts/headless-probe.ts",
    "telegram:test": "bun run scripts/telegram-test.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:performance": "node scripts/ui-performance.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
