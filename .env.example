BASE_URL=https://agentrouter.org
REQUEST_TIMEOUT_MS=45000
LOGIN_TIMEOUT_MS=120000
DASHBOARD_PORT=3100
DASHBOARD_HOST=127.0.0.1
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
DATA_DIR=data
ACCOUNT_FILE=data/accounts.json
SETTINGS_FILE=data/settings.json
DB_PATH=data/checks.sqlite
SCREENSHOT_DIR=data/screenshots
ACCOUNT_STATE_DIR=data/states
MAX_RECENT_RUNS=500
DISABLE_WEBAUTHN=true
