# AgentRouter Monitor - Production Environment Template
# Production install path: /etc/agentrouter-monitor/env
# Security requirement: Root-owned with mode 0600 (chown root:root /etc/agentrouter-monitor/env && chmod 0600 /etc/agentrouter-monitor/env)
# Systemd reads this file as root before dropping privileges to User=agentrouter.

# Base directory for runtime data (accounts.json, settings.json, checks.sqlite, states/, browser-profiles/)
DATA_DIR=/var/lib/agentrouter-monitor/data

# Explicit database path (optional, defaults to ${DATA_DIR}/checks.sqlite)
# DB_PATH=/var/lib/agentrouter-monitor/data/checks.sqlite

# Production dashboard binding (Tailscale IP and dedicated port)
DASHBOARD_HOST=100.127.29.78
DASHBOARD_PORT=8456
DASHBOARD_ALLOWED_ORIGINS=http://100.127.29.78:8456,http://bkserver:8456

# Private Node.js 24 LTS runtime (isolated from system Node)
NODE_BINARY=/opt/agentrouter-runtime/node/bin/node

# Browser settings
BROWSER_CHANNEL=chromium
DISABLE_WEBAUTHN=true

# Telegram Alerting Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERNAME=
TELEGRAM_LOW_BALANCE_USD=50
TELEGRAM_LARGE_DROP_USD=25
TELEGRAM_REPEATED_FAILURE_COUNT=3
TELEGRAM_GRAPHS_ENABLED=true
TELEGRAM_DASHBOARD_URL=http://100.127.29.78:8456

# OMP Quota Broker Integration (disabled by default)
OMP_QUOTA_ENABLED=false
OMP_EXECUTABLE=/opt/agentrouter-monitor/node_modules/.bin/omp
OMP_AUTH_BROKER_URL=
OMP_AUTH_BROKER_TOKEN=
OMP_QUOTA_INTERVAL_MINUTES=5
OMP_QUOTA_TIMEOUT_MS=45000
OMP_QUOTA_LOW_REMAINING_PCT=10
OMP_QUOTA_STATE_FILE=/var/lib/agentrouter-monitor/data/omp-quota-state.json
