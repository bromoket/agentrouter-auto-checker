# AI Fleet Observatory - isolated staging / burn-in environment template
# Install as /etc/ai-fleet-observatory/env; root-owned with mode 0600.
# This template contains placeholders only. Set owner credentials and registered
# collector identities before enabling either Observatory or collector ingestion.

# Separate staging runtime data (accounts, settings, state, browser profiles, databases)
DATA_DIR=/var/lib/ai-fleet-observatory/data
# Legacy AgentRouter checks database path (snapshot import source; legacy maintenance only)
DB_PATH=/var/lib/ai-fleet-observatory/data/checks.sqlite
# Normalized Observatory database path (must be distinct from DB_PATH; isolated normalized maintenance)
OBSERVATORY_DB_PATH=/var/lib/ai-fleet-observatory/data/observatory.sqlite

# Staging dashboard is loopback-only; expose it with Tailscale Serve HTTPS.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8458
# Dashboard is mounted at /observatory/ on the shared MagicDNS HTTPS host.
# Allowed origins intentionally contain no path.
DASHBOARD_ALLOWED_ORIGINS=https://bkserver.tailbbaa91.ts.net

# Owner authentication (required for non-loopback HTTPS access through Tailscale Serve)
DASHBOARD_AUTH_DISABLED=false
# Scope the browser session to the dedicated dashboard mount, never the shared `/` handler.
DASHBOARD_SESSION_COOKIE_PATH=/observatory/
DASHBOARD_API_KEY=__SET_OWNER_API_KEY__

# Private Node.js 24 LTS runtime (isolated from system Node)
NODE_BINARY=/opt/agentrouter-runtime/node/bin/node

# Native Google Chrome settings; CDP remains loopback-only and must not be proxied.
BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
BROWSER_WORKER_CDP_PORT=19222
BROWSER_POLLER_CDP_PORT=19223
BROWSER_START_TIMEOUT_MS=30000
BROWSER_POLLER_PROFILE_DIR=/var/lib/ai-fleet-observatory/data/poller-browser-profile

# Observatory is disabled until staging credentials and source registration are complete.
OBSERVATORY_ENABLED=false
OBSERVATORY_HMAC_KEY=__SET_32_BYTE_OR_LONGER_OBSERVATORY_KEY__
OBSERVATORY_SOURCE_HOST_ID=__SET_REGISTERED_SOURCE_HOST_ID__
OBSERVATORY_OMP_VERSION=__SET_PINNED_OMP_VERSION__

# Command Code subscription/quota monitoring (Requires OBSERVATORY_ENABLED=true).
COMMANDCODE_ENABLED=false
COMMANDCODE_DB_PATH=/var/lib/ai-fleet-observatory/data/commandcode.sqlite
COMMANDCODE_ENC_KEY=__SET_32_BYTE_OR_LONGER_COMMANDCODE_KEY__
COMMANDCODE_PROBE_INTERVAL_MINUTES=5
COMMANDCODE_PROBE_TIMEOUT_MS=30000

# ChatGPT / Codex subscription quota monitoring (Requires OBSERVATORY_ENABLED=true).
CHATGPT_ENABLED=false
CHATGPT_DB_PATH=/var/lib/ai-fleet-observatory/data/chatgpt.sqlite
CHATGPT_ENC_KEY=__SET_32_BYTE_OR_LONGER_CHATGPT_KEY__
CHATGPT_PROBE_INTERVAL_MINUTES=5
CHATGPT_PROBE_TIMEOUT_MS=30000

# Collector HTTPS ingestion is disabled until the trusted nginx proxy and registrations exist.
COLLECTOR_ENABLED=false
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8457
COLLECTOR_PUBLIC_ORIGIN=https://bkserver.tailbbaa91.ts.net:8457
COLLECTOR_REGISTRY_FILE=/var/lib/ai-fleet-observatory/collector/registry.json
COLLECTOR_TAILSCALE_EXECUTABLE=/usr/bin/tailscale
# Service-owned parent is 0700; token file is 0600 and contains one canonical 32-byte base64url secret.
COLLECTOR_PROXY_TOKEN_FILE=/var/lib/ai-fleet-observatory/collector/proxy-token

# Telegram alerting is disabled until a dedicated staging bot is provisioned.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERNAME=
TELEGRAM_DASHBOARD_URL=https://bkserver.tailbbaa91.ts.net/observatory/

# Observatory requires these broker credentials when OBSERVATORY_ENABLED=true;
# this does not enable the legacy OMP quota poller.
OMP_QUOTA_ENABLED=false
OMP_EXECUTABLE=/opt/ai-fleet-observatory/node_modules/.bin/omp
OMP_AUTH_BROKER_URL=__SET_OBSERVATORY_BROKER_URL__
OMP_AUTH_BROKER_TOKEN=__SET_OBSERVATORY_BROKER_TOKEN__
OMP_QUOTA_STATE_FILE=/var/lib/ai-fleet-observatory/data/omp-quota-state.json
